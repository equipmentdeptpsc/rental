{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./canonical-roles.schema.json",
  "title": "Canonical RBAC roles catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogType", "version", "roles"],
  "properties": {
    "catalogType": { "const": "canonical-rbac-roles" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "roles": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "name", "description", "systemManaged", "active"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "systemManaged": { "type": "boolean" },
          "active": { "type": "boolean" },
          "constraints": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
