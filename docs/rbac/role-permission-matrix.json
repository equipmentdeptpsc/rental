      "workflow": ["dashboard.financial.read", "rental.commercialTerms.read", "billing.invoice.export", "collections.reconcile"],
      "scopeRules": ["same-tenant", "financial-reports-only", "no-operational-approval", "no-billing-approval-close-delete-finalize-reopen-issue-void-or-reversal"]
