    },
    "dispatcher": {
      "standard": { "equipment": ["read"], "assignment": ["read", "create", "update"], "rental": ["read", "create", "update"], "deur": ["read"], "customer": ["read", "create", "update"], "project": ["read", "create", "update"], "operator": ["read", "update"], "reports": ["read"] },
