      "workflow": ["dashboard.read", "equipment.restore", "equipment.status.update", "equipment.assignment.coordinate", "assignment.equipment.replace"],
      "scopeRules": ["same-tenant", "no-operational-approval", "no-billing-authority"]
    },
    "operator": {
      "standard": { "assignment": ["read"], "equipment": ["read"], "deur": ["read", "create", "update"] },
      "workflow": ["deur.submit", "deur.activity.start", "deur.activity.stop", "deur.evidence.update"],
      "scopeRules": ["same-tenant", "requires-active-canonical-operator-link", "own-assignments-only", "own-equipment-only", "own-shift-only", "own-deur-history-only", "no-other-operators", "no-rental-assignment-equipment-maintenance-billing-dashboard-or-administration-authority"]
