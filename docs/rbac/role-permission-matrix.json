    "read-only-auditor": {
      "standard": { "equipment": ["read"], "assignment": ["read"], "rental": ["read"], "deur": ["read"], "billing": ["read"], "collections": ["read"], "maintenance": ["read"], "dailyLog": ["read"], "customer": ["read"], "project": ["read"], "operator": ["read"], "reports": ["read", "export"], "users": ["read"], "settings": ["read"] },
      "workflow": ["dashboard.executive.read", "dashboard.financial.read", "dashboard.export", "roles.read", "roles.compare", "roles.assignedUsers.read", "permissions.catalog.read", "users.auditHistory.read", "users.effectivePermissions.read"],
