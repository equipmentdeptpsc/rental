    "management-viewer": {
      "standard": { "equipment": ["read"], "assignment": ["read"], "rental": ["read"], "deur": ["read"], "billing": ["read"], "collections": ["read"], "maintenance": ["read"], "dailyLog": ["read"], "customer": ["read"], "project": ["read"], "operator": ["read"], "reports": ["read", "export"] },
      "workflow": ["dashboard.executive.read", "dashboard.financial.read", "dashboard.export"],
      "scopeRules": ["same-tenant", "read-and-approved-report-export-only", "no-transaction-authority", "redacted-exports-only"]
