{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "psc-ed",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "uat": {
      "name": "psc-ed-uat",
      "workers_dev": true,
      "vars": {
        "SUPABASE_URL": "https://jtkctarqbwmqdcewthkn.supabase.co",
        "REVIEW_PUBLIC_BASE_URL": "https://psc-ed-uat.equipmentdept-psc.workers.dev",
        "RESEND_FROM_ADDRESS": "notifications@pscequipment.online",
        "SCHEDULER_JOB_CRON": "*/15 * * * *",
        "NOTIFICATION_JOB_CRON": "*/2 * * * *",
        "SCHEDULER_BATCH_LIMIT": "1",
        "NOTIFICATION_WORKER_BATCH_LIMIT": "1",
        "ENABLE_UAT_RECIPIENT_OVERRIDE_VERIFIER": "true",
        "ENABLE_UAT_SYNTHETIC_PROVISIONER": "true",
        "USERNAME_LOGIN_ALLOWED_ORIGIN": "http://localhost:8081"
        ,"UAT_ADMIN_ALLOWED_ORIGINS": "http://localhost:8081,https://uat.pscequipment.online"
      },
      "triggers": {
        "crons": []
      },
      "ratelimits": [
        { "name": "USERNAME_LOGIN_NETWORK_BURST", "namespace_id": "220001", "simple": { "limit": 5, "period": 10 } },
        { "name": "USERNAME_LOGIN_NETWORK_SUSTAINED", "namespace_id": "220002", "simple": { "limit": 30, "period": 60 } },
        { "name": "USERNAME_LOGIN_IDENTIFIER_BURST", "namespace_id": "220003", "simple": { "limit": 3, "period": 10 } },
        { "name": "USERNAME_LOGIN_IDENTIFIER_SUSTAINED", "namespace_id": "220004", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
